{
  "name": "buksae-yukjin-beyond",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test:game": "node tools/run-game-tests.mjs",
    "test:game:slow": "node tools/run-game-tests.mjs --suite=slow",
    "test:game:balance": "node tools/run-game-tests.mjs --suite=balance",
    "test:game:assets": "node tools/run-game-tests.mjs --suite=assets",
    "test:game:ui": "node tools/run-game-tests.mjs --suite=ui",
    "test:game:full": "node tools/run-game-tests.mjs --suite=full",
    "test:game:suites": "node tools/run-game-tests.mjs --list-suites",
    "test:terrain-growth": "node tools/render/test_historical_terrain.mjs && node tools/render/test_terrain_growth_assets.mjs && node tools/render/test_terrain_growth_visuals.mjs",
    "test:building-assets": "node tools/render/test_cemetery_assets.mjs && node tools/render/test_oblique_building_assets.mjs && node tools/render/test_rainwater_cistern_building_assets.mjs",
    "test:livestock-assets": "node tools/render/test_livestock_assets.mjs",
    "test:corpse-assets": "node tools/render/test_corpse_coffin_assets.mjs",
    "test:no-local-paths": "node tools/test_no_local_paths.mjs",
    "measure:runtime": "node tools/game/measure_runtime_performance.mjs",
    "measure:map-sizes": "node tools/game/measure_map_size_s2.mjs",
    "test:combat": "node tools/game/test_tactical_battle.mjs",
    "gen:sprite-metrics": "node tools/game/generate_tactical_sprite_metrics.mjs",
    "edit:head-boxes": "node tools/game/head_box_editor.mjs",
    "check": "npm run test:no-local-paths && npm run test:game && npm run test:terrain-growth && npm run test:building-assets && npm run test:livestock-assets && npm run test:corpse-assets && npm run typecheck:sprites && npm run typecheck:balance && npm run build",
    "check:full": "npm run test:no-local-paths && npm run test:game:full && npm run test:terrain-growth && npm run test:building-assets && npm run test:livestock-assets && npm run test:corpse-assets && npm run typecheck:sprites && npm run typecheck:balance && npm run build",
    "edit:sprites": "vite --config tools/sprite-studio/vite.config.mts",
    "typecheck:sprites": "tsc -p tools/sprite-studio --noEmit",
    "edit:balance": "vite --config tools/balance-studio/vite.config.mts",
    "typecheck:balance": "tsc -p tools/balance-studio --noEmit",
    "gen:balance": "node tools/balance-studio/generate_balance_overrides.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
